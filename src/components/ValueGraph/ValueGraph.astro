---
import { demoReleases } from '../../lib/demo-data';
import { upcoming, latest } from '../../lib/releases';

const payload = JSON.stringify({
  releases: demoReleases,
  upcoming: upcoming.map((r) => ({ release: r.release, title: r.title })),
  defaultRelease: latest.release,
}).replace(/</g, '\\u003c');
---

<div class="vg" data-vg>
  <script type="application/json" data-vg-data set:html={payload} />

  <div class="vg-head">
    <div class="vg-intro">
      <h1>Explore Valuable</h1>
      <p>Ask a question, or click any card to trace it through the seven lenses. <span data-vg-asof>Demo data, fictional.</span></p>
    </div>
    <div class="vg-toggle" role="group" aria-label="View">
      <button type="button" data-vg-view="value" aria-pressed="true">Value view</button>
      <button type="button" data-vg-view="portfolio" aria-pressed="false">Portfolio view (skills)</button>
    </div>
  </div>

  <div class="vg-releases" role="group" aria-labelledby="vg-releases-label">
    <span id="vg-releases-label" class="vg-releases__label">Release</span>
    <div class="vg-releases__list" data-vg-releases></div>
  </div>

  <div class="vg-body">
    <aside class="vg-side" aria-label="Ask Valuable">
      <div class="card vg-ask">
        <h2>Ask Valuable</h2>
        <p class="vg-note" data-vg-note></p>
        <div class="vg-questions" data-vg-questions></div>
      </div>
      <div class="vg-answer" data-vg-answer aria-live="polite">
        <p class="vg-answer__label vg-answer__label--main">Answer</p>
        <p class="vg-answer__text" data-vg-answer-text></p>
        <p class="vg-answer__label">Based on</p>
        <p class="vg-answer__basis" data-vg-answer-basis></p>
        <p class="vg-answer__label">Confidence and gaps</p>
        <p class="vg-answer__gaps" data-vg-answer-gaps></p>
        <p class="vg-answer__fine" data-vg-answer-fine></p>
      </div>
    </aside>

    <section class="card vg-graph" aria-labelledby="vg-graph-title">
      <div class="vg-graph__bar">
        <h2 id="vg-graph-title" data-vg-graph-title>Value Graph</h2>
        <span class="vg-legend">
          <span><span class="vg-key vg-key--on" aria-hidden="true"></span>on the trace</span>
          <span><span class="vg-key vg-key--gap" aria-hidden="true"></span>gap</span>
        </span>
      </div>
      <div class="vg-trace" data-vg-trace hidden aria-live="polite">
        <div>
          <p class="vg-trace__label">Tracing</p>
          <p class="vg-trace__title" data-vg-trace-title></p>
          <p class="vg-trace__text" data-vg-trace-text></p>
        </div>
        <button type="button" class="vg-trace__clear" data-vg-trace-clear>Clear</button>
      </div>
      <div class="vg-lenses" data-vg-lenses></div>
      <p class="vg-foot" data-vg-foot></p>
    </section>
  </div>
</div>

<script>
  import { mountValueGraph } from './value-graph';
  document.querySelectorAll<HTMLElement>('[data-vg]').forEach(mountValueGraph);
</script>

<style>
  .vg-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end;
    gap: 20px; margin-bottom: 20px;
  }
  .vg-intro { flex: 1 1 420px; }
  .vg-intro h1 { margin: 0 0 6px; font-size: clamp(32px, 6vw, 40px); font-weight: 700; letter-spacing: -0.01em; }
  .vg-intro p { margin: 0; color: var(--ink-3); font-size: 16px; }

  .vg-toggle { display: flex; flex-wrap: wrap; background: var(--chip); border-radius: 10px; padding: 4px; }
  .vg-toggle button {
    border: 0; padding: 10px 16px; min-height: 44px; border-radius: 8px;
    font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
    background: transparent; color: var(--ink);
  }
  .vg-toggle button[aria-pressed='true'] { background: var(--ink); color: #fff; }

  .vg-releases {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 20px;
  }
  .vg-releases__label { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .vg-releases__list { display: flex; flex-wrap: wrap; gap: 8px; }
  .vg-releases__list :global(button) {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 14px;
    border: 1px solid var(--line); border-radius: 99px; background: var(--card);
    font: inherit; font-size: 14px; color: var(--ink); cursor: pointer; text-align: left;
  }
  .vg-releases__list :global(button[aria-pressed='true']) { border-color: var(--teal); background: var(--teal-soft); font-weight: 600; }
  .vg-releases__list :global(button:disabled) {
    cursor: not-allowed; border-style: dashed; border-color: var(--line-2); background: transparent; color: var(--muted);
  }
  .vg-releases__list :global(.vg-rel-num) { font-weight: 700; color: var(--teal); }
  .vg-releases__list :global(button:disabled .vg-rel-num) { color: var(--orange); }

  .vg-body { display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start; }
  .vg-side { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .vg-ask { padding: 18px; }
  .vg-ask h2 { margin: 0 0 4px; font-size: 18px; font-weight: 600; }
  .vg-note { margin: 0 0 12px; font-size: 13px; color: var(--muted); }
  .vg-questions { display: flex; flex-direction: column; gap: 8px; }
  .vg-questions :global(button) {
    text-align: left; border: 1px solid var(--line); background: var(--card);
    border-radius: 8px; padding: 12px; min-height: 44px;
    font: inherit; font-size: 14px; color: var(--ink); cursor: pointer;
  }
  .vg-questions :global(button:hover) { border-color: var(--line-2); }
  .vg-questions :global(button[aria-pressed='true']) { background: #F1EFE9; border-color: var(--ink); }

  .vg-answer {
    background: var(--ink); color: var(--paper); border-radius: var(--radius); padding: 20px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .vg-answer[hidden] { display: none; }
  .vg-answer p { margin: 0; }
  .vg-answer__label {
    margin-top: 6px !important; font-size: 12px; font-weight: 600; color: var(--faint);
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .vg-answer__label--main { margin-top: 0 !important; color: var(--teal-bright); }
  .vg-answer__text { font-size: 16px; line-height: 1.55; }
  .vg-answer__basis { font-size: 14px; color: #C9C7BF; line-height: 1.5; }
  .vg-answer__gaps { font-size: 14px; color: var(--peach); line-height: 1.5; }
  .vg-answer__fine { margin-top: 6px !important; font-size: 12px; color: var(--faint); font-style: italic; }

  .vg-graph { flex: 999 1 640px; min-width: 0; padding: 18px; }
  .vg-graph__bar {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 14px;
    font-size: 13px; color: var(--muted);
  }
  .vg-graph__bar h2 { margin: 0; font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--muted); }
  .vg-legend { display: flex; gap: 14px; flex-wrap: wrap; }
  .vg-key { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
  .vg-key--on { background: var(--teal); }
  .vg-key--gap { border: 1.5px dashed var(--orange); }

  .vg-trace {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;
    background: var(--teal-soft); border-radius: 10px; padding: 14px 16px; margin-bottom: 14px;
  }
  .vg-trace[hidden] { display: none; }
  .vg-trace p { margin: 0; }
  .vg-trace__label { font-size: 12px; font-weight: 600; color: var(--teal); letter-spacing: 0.06em; text-transform: uppercase; }
  .vg-trace__title { font-size: 16px; font-weight: 600; margin-top: 2px !important; }
  .vg-trace__text { font-size: 14px; color: var(--ink-3); }
  .vg-trace__clear {
    flex: none; min-height: 44px; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--teal);
    background: var(--card); color: var(--teal); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
  }

  .vg-lenses { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 1000px) {
    .vg-lenses { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; }
  }
  .vg-lenses :global(.vg-lens) { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .vg-lenses :global(.vg-lens h3) {
    margin: 0; font-family: var(--sans); font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.05em; color: var(--teal);
    padding-bottom: 6px; border-bottom: 2px solid var(--teal);
  }
  @media (min-width: 1000px) { .vg-lenses :global(.vg-lens h3) { min-height: 38px; } }
  .vg-lenses :global(.vg-cards) {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 8px;
  }
  @media (min-width: 1000px) { .vg-lenses :global(.vg-cards) { grid-template-columns: 1fr; } }
  .vg-lenses :global(.vg-card) {
    position: relative; text-align: left; font: inherit; color: var(--ink); cursor: pointer;
    background: var(--card-2); border: 1px solid var(--line); border-radius: 8px;
    padding: 10px; font-size: 13px; line-height: 1.35; min-height: 44px;
    transition: opacity 0.15s ease, background-color 0.15s ease;
    overflow-wrap: anywhere;
  }
  .vg-lenses :global(.vg-card:hover) { border-color: var(--line-2); }
  .vg-lenses :global(.vg-card__t) { display: block; font-weight: 600; }
  .vg-lenses :global(.vg-card__s) { display: block; font-size: 12px; color: var(--muted); margin-top: 4px; }
  .vg-lenses :global(.vg-card.is-gap) { background: var(--orange-soft); border: 1.5px dashed var(--orange); }
  .vg-lenses :global(.vg-card.is-on) { background: var(--teal-soft); border-color: var(--teal); }
  .vg-lenses :global(.vg-card.is-gap.is-on) { border-style: dashed; }
  .vg-lenses :global(.vg-card.is-dim) { opacity: 0.4; }
  .vg-lenses :global(.vg-card[aria-pressed='true']) { border: 2px solid var(--ink); padding: 9px; }
  .vg-lenses :global(.vg-card__new) {
    display: inline-block; margin-bottom: 4px; font-size: 11px; font-weight: 700; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--orange);
  }
  .vg-foot { margin: 14px 0 0; font-size: 13px; color: var(--muted); }

  @media (prefers-reduced-motion: reduce) {
    .vg-lenses :global(.vg-card) { transition: none; }
  }
</style>
