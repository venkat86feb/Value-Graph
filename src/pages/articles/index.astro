---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { upcoming } from '../../lib/releases';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.number - b.data.number,
);
const href = (id: string) => `/articles/${id.replace(/^\d+-/, '')}/`;
---

<Base title="Articles" description="Each article answers one question with the Value Graph, and ships a new release of the demo." active="articles">
  <div class="wrap list">
    <p class="eyebrow">The series</p>
    <h1>Articles</h1>
    <p class="intro">Each article answers one question with Valuable and the Value Graph. Every article is also a release of the graph, so you can open the demo at that point and see what changed.</p>
    <ol class="items">
      {articles.map((a) => (
        <li class="card item">
          <span class="meta">Release {a.data.release} · {a.data.kicker}</span>
          <h2><a href={href(a.id)}>{a.data.title}</a></h2>
          <p>{a.data.description}</p>
          <a href={`/explore/?release=${a.data.release}`} class="trace">See this release in the demo →</a>
        </li>
      ))}
      {upcoming.map((r) => (
        <li class="item item--next">
          <span class="meta">Release {r.release} · Coming next</span>
          <h2>{r.title}</h2>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .list { padding-top: 48px; padding-bottom: 64px; max-width: 760px; }
  h1 { margin: 0 0 12px; font-size: clamp(34px, 7vw, 44px); letter-spacing: -0.01em; }
  .intro { margin: 0 0 32px; color: var(--ink-3); font-size: 17px; }
  .items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .item { display: flex; flex-direction: column; gap: 8px; }
  .item h2 { margin: 0; font-size: 22px; line-height: 1.25; }
  .item h2 a { color: var(--ink); text-decoration: none; }
  .item h2 a:hover { text-decoration: underline; }
  .item p { margin: 0; color: var(--ink-3); font-size: 15px; }
  .meta { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--teal); }
  .trace { font-size: 14px; font-weight: 600; min-height: 44px; display: inline-flex; align-items: center; }
  .item--next { border: 1px dashed var(--line-2); border-radius: var(--radius); padding: 22px; }
  .item--next .meta { color: var(--orange); }
</style>
